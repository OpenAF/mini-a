{
  "$schema": "https://openaf.io/schemas/mini-a/web-extension/1.0/schema.json",
  "id": "org.openaf.drawio",
  "name": "Diagram editor",
  "description": "An optional adapter for a pinned local diagrams.net editor; browser conformance is required before enabling.",
  "version": "1.0.0",
  "apiVersions": ["1.0"],
  "entry": "index.html",
  "rendering": "iframe",
  "category": "editor",
  "activation": ["command", "open-with", "artifact"],
  "formats": [{"mimeTypes": ["application/vnd.jgraph.mxfile"], "extensions": [".drawio"], "artifactTypes": ["diagram/drawio"]}],
  "capabilities": ["render", "edit", "create", "export", "fullscreen"],
  "permissions": ["artifact.read", "artifact.propose-write", "artifact.propose-export", "ui.fullscreen"],
  "exports": [{"mimeType": "image/svg+xml", "extension": ".svg"}, {"mimeType": "image/png", "extension": ".png"}],
  "assetMounts": ["editor"],
  "childFrames": ["editor/index.html"],
  "network": {"origins": []},
  "offline": true,
  "resources": {"maxArtifactBytes": 8388608, "maxExportBytes": 16777216, "operationTimeoutMs": 60000},
  "license": "Apache-2.0",
  "licenseFiles": ["LICENSE", "THIRD-PARTY-NOTICES.md"],
  "extensions": {"x-mini-a-release-gate": {"id": "drawio-opaque-v1", "required": true}}
}
