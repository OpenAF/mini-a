{
  "$schema": "https://openaf.io/schemas/mini-a/web-extension/1.0/schema.json",
  "id": "org.openaf.text-editor",
  "name": "Text editor",
  "description": "A small, offline example of the Mini-A Web Extension API.",
  "version": "1.0.0",
  "apiVersions": ["1.0"],
  "entry": "index.html",
  "rendering": "iframe",
  "category": "editor",
  "activation": ["command", "open-with", "artifact"],
  "formats": [{"mimeTypes": ["text/plain"], "extensions": [".txt"], "artifactTypes": ["document/text"]}],
  "capabilities": ["render", "edit", "create", "export", "fullscreen"],
  "permissions": ["artifact.read", "artifact.propose-write", "artifact.propose-export", "ui.fullscreen"],
  "exports": [{"mimeType": "text/plain", "extension": ".txt"}],
  "network": {"origins": []},
  "offline": true,
  "license": "Apache-2.0",
  "licenseFiles": ["LICENSE"]
}
